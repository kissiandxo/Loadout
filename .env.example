# LOADOUT storefront — environment template
# The storefront is a STATIC Astro build and needs NO runtime secrets to build or serve.
# Everything below is deploy-/integration-time reference only. Copy to `.env` if needed.

# Public site URL — canonical source of truth lives in astro.config.mjs `site`.
# Update both when you buy the real domain.
PUBLIC_SITE_URL=https://yourloadout.com

# --- Deploy (Cloudflare Pages / Vercel) ---
# NODE_VERSION=20   # build env; set in the host dashboard, not here

# --- Future / optional integrations (NOT required for the static site) ---
# Only needed if you later add server-side license validation or a checkout webhook.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
