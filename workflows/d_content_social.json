          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"prompt\": {{ JSON.stringify($json.imagePrompt) }},\n  \"n\": 1,\n  \"size\": \"1024x1024\"\n}",
          "options": {}
        },
        "id": "cd8e2e61-0631-4f74-8e0c-06183c90fd60",
