          1100,
          400
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
