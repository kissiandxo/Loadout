    "name": "D21 — Competitor Post Responder (AI)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours"
              }
            ]
          }
        },
        "id": "502b1b86-e27e-4d0b-80e3-e1ae529d32c4",
