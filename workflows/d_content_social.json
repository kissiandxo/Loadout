  {
    "id": "da088e26-83da-4691-8f9b-44483ba46b14",
    "name": "D16 — Social Scheduler & Publisher",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours",
                "triggerAtHour": 8
              }
            ]
          }
        },
        "id": "bcd408cb-69fd-48aa-89e7-7ab92147d9d8",
        "name": "Daily 8am",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": {
            "__rl": true,
            "value": "={{$env.CONTENT_SHEET_ID}}",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "ContentQueue",
            "mode": "name"
          },
          "options": {}
        },
        "id": "36340a9c-5f5a-4530-8f8b-ea9c3005fe9b",
        "name": "Read Content Queue",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          420,
          300
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "1ad26f39-94aa-4474-89d2-fd04f43363f1",
            "name": "LOADOUT Google Sheets"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const today=new Date().toISOString().slice(0,10); return items.map(i=>i.json).filter(r=>(r.status||'queued')!=='posted' && (r.scheduledFor||'').slice(0,10)<=today).slice(0,1).map(r=>({json:r}));"
        },
        "id": "9ea51400-ff4e-4c6e-84de-78d4f2627ef4",
        "name": "Pick Due Post",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          640,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": false,
              "version": 2
            },
            "combinator": "and",
            "conditions": [
              {
                "id": "a54c40d0-c0be-4f9a-84fb-62d8c1b9ab24",
                "leftValue": "={{$env.SOCIAL_AUTOPUBLISH}}",
                "rightValue": "true",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ]
          }
        },
        "id": "b994f856-8dab-4dcb-81f4-73233466d18b",
        "name": "Auto-publish on?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          860,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{$env.SOCIAL_PUBLISH_URL}}",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"platform\": {{ JSON.stringify($json.platform || 'facebook') }}\n}",
          "options": {}
        },
        "id": "c5c34e63-c07f-4d09-86f3-28d262c0e172",
        "name": "Publish (opt-in)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1100,
          220
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "sendTo": "={{$env.OWNER_EMAIL}}",
          "subject": "=Post ready to approve — {{$json.platform || 'social'}}",
          "message": "=Today's queued post (auto-publish is OFF, so paste it yourself or flip SOCIAL_AUTOPUBLISH to true):\n\n{{$json.text}}",
          "options": {}
        },
        "id": "4b63275f-4fef-4610-87ad-f4743d623f46",
        "name": "Send Draft for Approval",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
