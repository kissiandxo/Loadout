        "onError": "continueErrorOutput",
        "retryOnFail": true
      },
      {
        "parameters": {
          "jsCode": "const j=$json;\n// support common shapes: OpenAI {data:[{url|b64_json}]}, Replicate {output:[url]}, fal {images:[{url}]}\nconst url = (j.data&&j.data[0]&&(j.data[0].url||(j.data[0].b64_json?('data:image/png;base64,'+j.data[0].b64_json):'')))\n  || (Array.isArray(j.output)?j.output[0]:j.output) || (j.images&&j.images[0]&&j.images[0].url) || '';\nconst c=$('Parse Concept').item.json;\nreturn [{json:{imageUrl:url, caption:c.caption, concept:c.concept, competitor:c.competitor, ref:c.ref}}];"
        },
