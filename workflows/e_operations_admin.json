        "id": "f297dd46-f036-4879-8b06-3553bbbfaeb7",
        "name": "Nightly 1am",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          220,
          300
        ]
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": {
            "__rl": true,
            "value": "={{$env.CRM_SHEET_ID}}",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "Leads",
            "mode": "name"
          },
          "options": {}
        },
        "id": "d394f01d-b7c7-4dd5-8af1-54c6c3f04ce1",
        "name": "Read Leads",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          440,
          300
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "1ad26f39-94aa-4474-89d2-fd04f43363f1",
            "name": "LOADOUT Google Sheets"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const rows=items.map(i=>i.json); const seen=new Set(); let dups=0; const gaps=[];\nfor(const r of rows){ const key=(r.email||'').toLowerCase(); if(key&&seen.has(key)){dups++;continue;} if(key)seen.add(key);\n  if(!r.name||!r.phone) gaps.push(r.email||'(no email)'); }\nreturn [{json:{total:rows.length, duplicates:dups, missingFields:gaps.length, gapList:gaps.slice(0,20).join(', ')}}];"
        },
        "id": "1b15d923-6181-4ddb-8e8f-edb84bf5ac4a",
        "name": "Dedupe & Flag Gaps",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
          300
        ]
      },
      {
        "parameters": {
          "sendTo": "={{$env.OWNER_EMAIL}}",
          "subject": "=CRM hygiene — {{$json.duplicates}} dupes, {{$json.missingFields}} gaps",
          "message": "=Nightly CRM check:\nRecords: {{$json.total}}\nDuplicates: {{$json.duplicates}}\nMissing fields: {{$json.missingFields}}\n\nNeeds attention: {{$json.gapList}}",
          "options": {}
        },
        "id": "26343973-f243-4d08-8d49-b0bb9ca31d1a",
        "name": "CRM Hygiene Report",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
        "position": [
          880,
          300
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
