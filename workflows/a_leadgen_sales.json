  {
    "id": "99c1d104-fd94-4678-82be-54bee26c367d",
    "name": "A5 — Cold Outreach Engine",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours",
                "triggerAtHour": 9
              }
            ]
          }
        },
        "id": "7e69ce0f-6d8b-426a-8ee6-b82755694b01",
        "name": "Daily 9am",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.apollo.io/v1/mixed_people/search",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "X-Api-Key",
                "value": "={{$env.APOLLO_API_KEY}}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"page\": 1,\n  \"per_page\": {{$env.COLD_LEADS_PER_DAY || 10}},\n  \"person_titles\": {{$env.ICP_TITLES_JSON || '[\"owner\"]'}}\n}",
          "options": {}
        },
        "id": "ca9bf94e-ccfb-4ce0-8705-5846efa7ef04",
        "name": "Find Leads (Apollo)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          420,
          300
        ],
        "onError": "continueErrorOutput",
        "retryOnFail": true
      },
      {
        "parameters": {
          "jsCode": "const people = ($input.first().json.people || []).filter(p => p.email);\nconst seen = new Set();\nconst out = [];\nfor (const p of people) { if (seen.has(p.email)) continue; seen.add(p.email);\n  out.push({ json: { name: p.first_name||'', email: p.email, title: p.title||'', company: (p.organization&&p.organization.name)||'' } }); }\nreturn out;"
        },
        "id": "cbebaa67-4b09-4bf5-8d2a-16c566644b11",
        "name": "Dedupe & Pick",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          640,
          220
        ]
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=Prospect:\nName: {{$json.name}}\nTitle: {{$json.title}}\nCompany: {{$json.company}}\nWrite their email.",
          "options": {
            "systemMessage": "=You write cold outreach for {{$env.BUSINESS_NAME}}. Write a personalised email UNDER 150 words to the prospect. One specific, relevant hook, one clear soft CTA. No spam, no hype. Include an unsubscribe line: 'Reply STOP to opt out.' Output ONLY the email body."
          }
        },
        "id": "57244a0c-d63c-4817-8789-9e048b52dd5c",
        "name": "AI Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 1.7,
        "position": [
          860,
          220
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "model": {
            "__rl": true,
            "mode": "list",
            "value": "claude-sonnet-4-5-20250929"
          },
          "options": {}
        },
