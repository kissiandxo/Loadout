      {
        "parameters": {
          "jsCode": "const now = Date.now();\nconst rows = items.map(i => i.json).filter(r => (r.status||'').toLowerCase() !== 'converted');\nconst out = [];\nfor (const r of rows) {\n  const step = parseInt(r.nurtureStep||'0', 10);\n  const last = r.lastTouch ? Date.parse(r.lastTouch) : 0;\n  const dueAfter = [0, 2, 5, 9][step] || null; // days between touches\n  if (dueAfter === null) continue;\n  if (!last || (now - last) / 86400000 >= dueAfter) out.push({ json: { ...r, nextStep: step + 1 } });\n}\nreturn out;"
        },
