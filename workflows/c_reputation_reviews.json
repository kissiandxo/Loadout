  {
    "id": "b2a2caaf-d48e-467e-8b95-dfe66e860ebb",
    "name": "C17 — Brand Mention Monitor (AI)",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours"
              }
            ]
          }
        },
        "id": "c1e2c6a4-cfc0-46ba-8f37-4771b2419204",
        "name": "Hourly",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          300
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{$env.BRAND_MENTION_FEED_URL}}",
          "options": {}
        },
        "id": "f57de1c9-0a05-45d2-8d1c-39ed12ce630b",
        "name": "Fetch Mentions",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          420,
          300
        ],
        "onError": "continueErrorOutput",
        "retryOnFail": true
      },
      {
        "parameters": {
          "jsCode": "const raw=$json.data||$json.body||JSON.stringify($json);\nconst txt=typeof raw==='string'?raw:JSON.stringify(raw);\nconst since=Date.now()-3600000;\n// crude RSS item split; works for Google Alerts / most feeds\nconst items_=[...txt.matchAll(/<entry>([\\s\\S]*?)<\\/entry>|<item>([\\s\\S]*?)<\\/item>/g)].map(m=>m[1]||m[2]||'');\nconst out=[];\nfor(const it of items_){\n  const title=(it.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/)||[])[1]||'';\n  const link=(it.match(/<link[^>]*href=\"([^\"]+)\"|<link>([^<]+)<\\/link>/)||[]);\n  const url=link[1]||link[2]||'';\n  const pub=Date.parse((it.match(/<(?:published|pubDate|updated)>([^<]+)</)||[])[1]||0)||Date.now();\n  if(pub>=since) out.push({json:{title:title.replace(/<[^>]+>/g,'').trim(), url, snippet:it.replace(/<[^>]+>/g,' ').slice(0,400)}});\n}\nreturn out;"
        },
        "id": "127848a2-23e9-44e7-83de-37f46fc43562",
        "name": "New Mentions",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          640,
          300
        ]
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=Mention: {{$json.title}}\n{{$json.snippet}}\nLink: {{$json.url}}",
          "options": {
            "systemMessage": "=You monitor online mentions of {{$env.BUSINESS_NAME}}. For this mention, output JSON ONLY: {\"sentiment\":\"positive|negative|neutral\",\"needsReply\":true|false,\"draft\":\"an on-brand public reply if needed, else empty\"}. Negative = calm and solution-focused; positive = warm thanks; never defensive, never share private info."
          }
        },
        "id": "2c183f54-f8c9-4858-8a9b-2c121e986db2",
        "name": "AI Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 1.7,
        "position": [
          860,
          300
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "model": {
            "__rl": true,
            "mode": "list",
            "value": "claude-sonnet-4-5-20250929"
          },
          "options": {}
        },
        "id": "d8f5f2f5-7dfd-405a-8b6c-2cbdd37df4d4",
        "name": "Claude (Anthropic)",
        "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
        "typeVersion": 1.2,
        "position": [
          820,
          480
        ],
        "credentials": {
          "anthropicApi": {
