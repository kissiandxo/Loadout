  {
    "id": "6c109c5b-2d4d-46ba-8a9d-3d387ee67584",
    "name": "B9 — Support Inbox Triage (AI)",
    "nodes": [
      {
        "parameters": {
          "pollTimes": {
            "item": [
              {
                "mode": "everyMinute"
              }
            ]
          },
          "simple": true,
          "filters": {}
        },
        "id": "2ea0863a-d830-4550-8074-d5a26a38c358",
        "name": "New Support Email",
        "type": "n8n-nodes-base.gmailTrigger",
        "typeVersion": 1.2,
        "position": [
          220,
          300
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        }
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "=From: {{$json.from}}\nSubject: {{$json.subject}}\nBody: {{$json.snippet || $json.text}}",
          "options": {
            "systemMessage": "=You triage the support inbox for {{$env.BUSINESS_NAME}}. For the message, output JSON with: category (sales|support|billing|spam|other), priority (high|medium|low), and a drafted reply in the brand's friendly voice. Output ONLY valid JSON: {\"category\":\"\",\"priority\":\"\",\"draft\":\"\"}."
          }
        },
        "id": "8641412d-8206-455a-89a6-2c3bb4bfc592",
        "name": "AI Agent",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 1.7,
        "position": [
          460,
          300
        ],
        "onError": "continueErrorOutput"
      },
      {
        "parameters": {
          "model": {
            "__rl": true,
            "mode": "list",
            "value": "claude-sonnet-4-5-20250929"
          },
          "options": {}
        },
        "id": "fa6c935a-f87f-476f-840b-b34904e2aaef",
        "name": "Claude (Anthropic)",
        "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
        "typeVersion": 1.2,
        "position": [
          420,
          480
        ],
        "credentials": {
          "anthropicApi": {
            "id": "7001ff2d-e1ea-4f12-893c-cf68e619ec12",
            "name": "LOADOUT Anthropic"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "let o={}; try{o=JSON.parse($json.output)}catch(e){o={category:'other',priority:'medium',draft:$json.output}}; return [{json:{...o, from:$('New Support Email').item.json.from, subject:$('New Support Email').item.json.subject}}];"
        },
        "id": "f6605c37-bd68-46ea-8e12-68ae03464043",
        "name": "Parse Triage",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          760,
          300
        ]
      },
      {
        "parameters": {
          "resource": "draft",
          "operation": "create",
          "subject": "=Re: {{$json.subject}}",
          "message": "={{$json.draft}}",
          "options": {
            "sendTo": "={{$json.from}}"
          }
        },
        "id": "3cd823f7-78a7-4202-8450-32f0df8e456b",
        "name": "Save Draft Reply",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
        "position": [
          1000,
          220
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "operation": "append",
          "documentId": {
            "__rl": true,
            "value": "={{$env.LOADOUT_LOG_SHEET_ID}}",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "Runs",
            "mode": "name"
          },
          "columns": {
            "mappingMode": "autoMapInputData",
            "value": {}
          },
          "options": {}
        },
        "id": "60537c2a-d692-40de-89c0-2f46cb24ed7e",
        "name": "Log Run",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          1000,
          380
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "1ad26f39-94aa-4474-89d2-fd04f43363f1",
            "name": "LOADOUT Google Sheets"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
