  {
    "id": "6a24623c-9293-4d58-8f21-85264d476955",
    "name": "LOADOUT — Cost & Usage Tracker",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "hours",
                "triggerAtHour": 23
              }
            ]
          }
        },
        "id": "d890decc-5b97-4968-89e7-47a1f601b0c1",
        "name": "Nightly 11pm",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          260,
          300
        ]
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": {
            "__rl": true,
            "value": "={{$env.LOADOUT_LOG_SHEET_ID}}",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "Runs",
            "mode": "name"
          },
          "options": {}
        },
        "id": "3954e6b4-3268-4a81-8437-c250bb57f9ad",
        "name": "Read Runs",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          480,
          300
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "1ad26f39-94aa-4474-89d2-fd04f43363f1",
            "name": "LOADOUT Google Sheets"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "// rough daily roll-up. AI cost ~ tokens; here we count AI runs * avg cents.\nconst rows = items.map(i => i.json);\nconst today = new Date().toISOString().slice(0,10);\nconst todays = rows.filter(r => (r.time||'').slice(0,10) === today);\nconst aiRuns = todays.filter(r => (r.kind||'').includes('ai')).length;\nconst estUsd = (aiRuns * 0.03).toFixed(2); // ~3c per AI run, adjust to taste\nreturn [{ json: { date: today, totalRuns: todays.length, aiRuns, estUsd } }];"
        },
        "id": "68a8b198-3cb1-4c85-8b28-e0f0208b8001",
        "name": "Estimate Cost",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          700,
          300
        ]
      },
      {
        "parameters": {
          "sendTo": "={{$env.OWNER_EMAIL}}",
          "subject": "=LOADOUT cost estimate — {{$json.date}}",
          "message": "=Runs today: {{$json.totalRuns}} (AI: {{$json.aiRuns}})\nEstimated AI spend today: ~${{$json.estUsd}}\n\nThis is an estimate from your run log. Your real bill is on console.anthropic.com.",
          "options": {}
        },
        "id": "b5fbb14a-3b50-431d-8fb0-7e703bdd7c78",
        "name": "Email Cost Digest",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
        "position": [
          920,
          300
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
      "Nightly 11pm": {
        "main": [
          [
            {
              "node": "Read Runs",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Read Runs": {
        "main": [
          [
            {
              "node": "Estimate Cost",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Estimate Cost": {
        "main": [
          [
            {
              "node": "Email Cost Digest",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "errorWorkflow": "e6747a50-02dc-46f6-8ad9-ef0c35b9572d"
    },
    "active": false
  },
  {
    "id": "a3721dd9-f321-47d9-8fe5-5602872d782a",
