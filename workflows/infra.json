        "id": "8e4ec3f7-0ba4-4fa4-8f6f-8a9516810228",
        "name": "List Workflows",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          300
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const data = $input.first().json.data || [];\nreturn [{ json: { activeCount: data.length, names: data.map(w => w.name).join(', ') || 'none' } }];"
        },
        "id": "c9d35deb-e70a-44f0-8ece-5f6c38ccf8a2",
