          "options": {}
        },
        "id": "bbb9fa0f-842a-412b-8c67-8abb6fb9623c",
        "name": "Email Health",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.1,
        "position": [
          920,
          300
        ],
        "credentials": {
          "gmailOAuth2": {
            "id": "da21550e-fb6b-470f-8939-635e709e955d",
            "name": "LOADOUT Gmail"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
      "Daily 7am": {
        "main": [
          [
            {
              "node": "List Workflows",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "List Workflows": {
        "main": [
