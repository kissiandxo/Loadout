# ============================================================================
# LOADOUT — Growth Autopilot · Credential Vault (TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to `config.env` and fill in the values for the workers you turn
# on. You only need the credentials your chosen workers actually use — leave the
# rest blank. Your installer (Claude Code) will walk you through each one.
#
#   cp config.env.template config.env      # then edit config.env
#
# SECURITY: `config.env` is gitignored. Never commit it, never paste these keys
# into chat. If a key ever leaks, rotate it at the provider immediately.
# ============================================================================


# -- CORE (required for almost everything) ----------------------------------

# Your business name — used in every AI message and email signature.
BUSINESS_NAME="Your Business"

# Where owner notifications/alerts/digests are emailed.
OWNER_EMAIL="you@example.com"

# Your local timezone (IANA name) so schedules fire in YOUR time, not UTC.
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ="Australia/Sydney"
GENERIC_TIMEZONE="Australia/Sydney"


# -- AI BACKBONE — Anthropic (required, powers every AI worker) --------------
# PAY-PER-USE. This is NOT a Claude Pro/Max subscription.
# Get it: https://console.anthropic.com  ->  Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=""


# -- n8n SELF-CONTROL (required — health digest, kill-switch use these) ------
# The base URL n8n is reachable at (local default shown). On a VPS use its URL.
N8N_API_URL="http://localhost:5678"
# Create in n8n: Settings -> n8n API -> Create an API key.
N8N_API_KEY=""


# -- GOOGLE — Sheets (CRM + logs) & Gmail, both via one OAuth client ---------
# One-time: create an OAuth client at https://console.cloud.google.com
# (APIs & Services -> Credentials -> OAuth client ID -> Web application). Paste
# the client ID/secret here; the installer pre-creates the credential and you
# click "Connect" + "Approve" once in n8n (no passwords ever stored here).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# These are the SHEET IDs — the long string in the sheet URL between /d/ and /edit.
#   CRM sheet needs tabs: Leads, Appointments, Orders, Jobs, Customers
#   Log sheet needs tabs: Runs, Errors, Metrics, Backup, Approvals, Invoices
#   Content sheet needs tabs: ContentQueue, Updates
CRM_SHEET_ID=""
LOADOUT_LOG_SHEET_ID=""
CONTENT_SHEET_ID=""


# -- EMAIL — Gmail (lead replies, quotes, digests) ---------------------------
# Connected via the "Approve" screen during install (OAuth). Nothing to paste here.
# (If you use Outlook or plain SMTP instead, the installer swaps the email nodes.)


# -- MESSAGING — Slack (error alerts, escalations, optional reporting) -------
# Create a Slack app + bot token (xoxb-...) at https://api.slack.com/apps
# (OAuth & Permissions -> Bot Token Scopes: chat:write -> Install to workspace).
SLACK_BOT_TOKEN=""
# Channel ID: open the channel in Slack -> View channel details -> ID at bottom.
SLACK_ALERT_CHANNEL=""


# -- SMS / CALLS — Twilio (missed-call text-back, reminders) -----------------
# Get from https://console.twilio.com (Account Info panel).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                  # your Twilio number in +E.164 form, e.g. +61400000000


# -- BOOKING + REVIEWS (links used in messages) ------------------------------
# Your Calendly / Cal.com / Google Calendar booking link.
BOOKING_LINK=""
# Where customers leave reviews (Google/Trustpilot/Facebook).
REVIEW_LINK=""


# -- WORKER SETTINGS (sensible defaults — tune to taste) ---------------------
# Where digests/briefings go: "email" or "slack".
REPORT_CHANNEL="email"
# Website chatbot + FAQ answers come from this knowledge text (paste your FAQ).
FAQ_TEXT="We help customers with our products and services. Contact us for anything we haven't covered."
# Social auto-publish: "false" = draft + approval (recommended). "true" = post automatically.
SOCIAL_AUTOPUBLISH="false"
# If auto-publish is on, the endpoint that actually posts (your buffer/Make/Zapier hook).
SOCIAL_PUBLISH_URL=""
# Competitor Ad Watcher: which market to check ads in (ISO country, e.g. AU, US, GB).
ADS_COUNTRY="AU"
# Churn radar: a customer is "at risk" after this many days of no activity.
CHURN_DORMANT_DAYS="60"
# KPI Watchdog thresholds — alert when breached. Leave 0 to ignore a check.
KPI_SALES_FLOOR="0"
KPI_COMPLAINT_CEILING="5"
KPI_SPEND_CEILING="1000"


# -- COLD OUTREACH — lead sourcing (OPTIONAL, paid, only if A5 is on) --------
# COST WARNING: Apollo/Hunter charge you separately. Disclosed up front.
# Apollo: https://app.apollo.io -> Settings -> Integrations -> API.
APOLLO_API_KEY=""
# Or Hunter instead: https://hunter.io -> API.
HUNTER_API_KEY=""
# How many fresh leads to email per day, and who to target (JSON array of titles).
COLD_LEADS_PER_DAY="10"
ICP_TITLES_JSON='["owner","founder","general manager"]'


# -- AD INTELLIGENCE — Competitor Ad Watcher (OPTIONAL, only if D5 is on) ----
# Meta Ads Library access token (tracks ADS, not organic posts).
# Get a token: https://developers.facebook.com  (Ads Library API).
META_ADS_TOKEN=""
# Comma-separated competitor Facebook Page IDs to watch.
COMPETITOR_PAGE_IDS=""


# -- COMPETITOR POST RESPONDER — D21 (OPTIONAL, only if D21 is on) -----------
# Watches competitors' PUBLIC Instagram Business/Creator posts and auto-creates
# an ORIGINAL on-brand response post (image + caption) for your approval.
# Needs an Instagram Graph API token + YOUR linked IG Business account id.
# Setup: https://developers.facebook.com -> Instagram Graph API (business_discovery).
IG_GRAPH_TOKEN=""
IG_BUSINESS_ACCOUNT_ID=""
# Comma-separated competitor IG usernames (must be public Business/Creator accounts).
COMPETITOR_IG_USERNAMES=""
# Image engine (pluggable): point at any text-to-image API that takes a JSON
# {"prompt": "..."} and returns an image url or base64. Works with OpenAI Images
# (https://api.openai.com/v1/images/generations), Replicate, fal.ai, etc.
# NOTE: a ChatGPT Plus subscription does NOT include API access — you need an API key.
IMAGE_GEN_URL=""
IMAGE_GEN_KEY=""


# -- GOOGLE AD WATCHER — D22 (OPTIONAL, only if D22 is on) -------------------
# Google has no official public ads API, so plug in a transparency-data provider
# (e.g. SerpApi's Google Ads Transparency Center API). It should return a list of
# ads with a first-shown/start date so we can rank by longevity (winner proxy).
ADS_TRANSPARENCY_URL=""
ADS_TRANSPARENCY_KEY=""
# Comma-separated competitor advertiser names/domains/IDs to watch.
GOOGLE_ADS_ADVERTISERS=""


# -- ACCOUNTING — invoices (OPTIONAL, only if E1 is on) ----------------------
# QuickBooks / Xero connect via OAuth in the installer. If you'd rather log to a
# Sheet, set this to that sheet's ID and the installer points E1 at it instead.
ACCOUNTING_SHEET_ID=""


# -- REFERRAL (only if C16 is on) --
REFERRAL_LINK=""
