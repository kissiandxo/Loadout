# ============================================================================
# LOADOUT — Growth Autopilot · Credential Vault (TEMPLATE)
# ----------------------------------------------------------------------------
# Copy this file to `config.env` and fill in the values for the workers you turn
# on. You only need the credentials your chosen workers actually use — leave the
# rest blank. Your installer (Claude Code) will walk you through each one.
#
#   cp config.env.template config.env      # then edit config.env
#
# SECURITY: `config.env` is gitignored. Never commit it, never paste these keys
# into chat. If a key ever leaks, rotate it at the provider immediately.
# ============================================================================


# -- CORE (required for almost everything) ----------------------------------

# Your business name — used in every AI message and email signature.
BUSINESS_NAME="Your Business"

# Where owner notifications/alerts/digests are emailed.
OWNER_EMAIL="you@example.com"

# Your local timezone (IANA name) so schedules fire in YOUR time, not UTC.
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ="Australia/Sydney"
GENERIC_TIMEZONE="Australia/Sydney"


# -- AI BACKBONE — Anthropic (required, powers every AI worker) --------------
# PAY-PER-USE. This is NOT a Claude Pro/Max subscription.
# Get it: https://console.anthropic.com  ->  Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=""


# -- n8n SELF-CONTROL (required — health digest, kill-switch use these) ------
# The base URL n8n is reachable at (local default shown). On a VPS use its URL.
N8N_API_URL="http://localhost:5678"
# Create in n8n: Settings -> n8n API -> Create an API key.
N8N_API_KEY=""


# -- GOOGLE SHEETS — CRM + logs (most workers log here) ----------------------
# Connected via the "Approve" screen during install (OAuth, no password here).
# These are the SHEET IDs — the long string in the sheet URL between /d/ and /edit.
#   CRM sheet needs tabs: Leads, Appointments
#   Log sheet needs tabs: Runs, Errors
CRM_SHEET_ID=""
LOADOUT_LOG_SHEET_ID=""


# -- EMAIL — Gmail (lead replies, quotes, digests) ---------------------------
# Connected via the "Approve" screen during install (OAuth). Nothing to paste here.
# (If you use Outlook or plain SMTP instead, the installer swaps the email nodes.)


# -- MESSAGING — Slack (error alerts, optional reporting) --------------------
# Connected via OAuth during install. You only need the channel ID below.
# Channel ID: open the channel in Slack -> View channel details -> ID at bottom.
SLACK_ALERT_CHANNEL=""


# -- SMS / CALLS — Twilio (missed-call text-back, reminders) -----------------
# Get from https://console.twilio.com  (Account SID + Auth Token go in the
# installer's OAuth/credential step; the FROM number goes here).
TWILIO_FROM=""                  # your Twilio number in +E.164 form, e.g. +61400000000


# -- BOOKING (instant responder + nurture link to this) ----------------------
# Your Calendly / Cal.com / Google Calendar booking link.
BOOKING_LINK=""


# -- COLD OUTREACH — lead sourcing (OPTIONAL, paid, only if A5 is on) --------
# COST WARNING: Apollo/Hunter charge you separately. Disclosed up front.
# Apollo: https://app.apollo.io -> Settings -> Integrations -> API.
APOLLO_API_KEY=""
# Or Hunter instead: https://hunter.io -> API.
HUNTER_API_KEY=""
# How many fresh leads to email per day, and who to target (JSON array of titles).
COLD_LEADS_PER_DAY="10"
ICP_TITLES_JSON='["owner","founder","general manager"]'


# -- AD INTELLIGENCE — Competitor Ad Watcher (OPTIONAL, only if D5 is on) ----
# Meta Ads Library access token (tracks ADS, not organic posts).
# Get a token: https://developers.facebook.com  (Ads Library API).
META_ADS_TOKEN=""
# Comma-separated competitor Facebook Page IDs to watch.
COMPETITOR_PAGE_IDS=""


# -- ACCOUNTING — invoices (OPTIONAL, only if E1 is on) ----------------------
# QuickBooks / Xero connect via OAuth in the installer. If you'd rather log to a
# Sheet, set this to that sheet's ID and the installer points E1 at it instead.
ACCOUNTING_SHEET_ID=""
