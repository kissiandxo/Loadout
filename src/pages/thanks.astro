---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="You're in — check your email"
  description="Your Loadout bundle is on its way. Here's how to get started."
>
  <Nav />
  <main class="pt-36 pb-28 px-5 sm:px-8">
    <div class="max-w-2xl mx-auto">

      <!-- Confirmation -->
      <div data-reveal class="mb-14">
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-accent bg-accent-ghost border border-accent/25 rounded-full px-4 py-1.5 mb-8">
          Purchase confirmed
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-4">
          You're in. Check your email.
        </h1>
        <p class="text-muted text-lg leading-relaxed">
          Your bundle is being delivered via the email you used at checkout.
          Check your inbox (and spam, just in case) — you should have it within a few minutes.
        </p>
      </div>

      <!-- What to do next -->
      <div data-reveal data-reveal-delay="1" class="space-y-5 mb-14">
        <h2 class="text-xl font-bold text-white">What to do right now</h2>
        <div class="space-y-4">
          {[
            { n: '1', title: 'Check your email', body: 'The download link and setup guide are in your purchase confirmation email from the payment platform.' },
            { n: '2', title: 'Download the Setup Guide', body: 'Open the PDF. It walks you through every step with screenshots. This is where you start.' },
            { n: '3', title: 'Get Claude Pro (if you haven\'t yet)', body: 'Go to claude.ai and upgrade to Pro ($20/month). You need this to install skills and plugins.' },
            { n: '4', title: 'Follow the guide', body: 'Install your skills and plugins one by one. Most people are fully set up in under 30 minutes.' },
          ].map((step) => (
            <div class="flex gap-4 p-5 rounded-lg border border-edge bg-surface-2">
              <div class="w-7 h-7 rounded-md bg-accent-ghost border border-accent/25 flex items-center justify-center shrink-0 mt-0.5">
                <span class="text-accent font-bold text-xs">{step.n}</span>
              </div>
              <div>
                <p class="text-white font-semibold text-sm mb-1">{step.title}</p>
                <p class="text-muted text-sm leading-relaxed">{step.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Access section placeholder -->
      <div data-reveal data-reveal-delay="2" class="p-6 rounded-lg border border-edge bg-surface-2 mb-14">
        <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-3">Your downloads</p>
        <p class="text-muted text-sm leading-relaxed mb-4">
          <!-- TODO: If you're using a platform like Gumroad or Lemon Squeezy, they handle download delivery
               via the purchase email automatically. You can optionally embed a direct access section here
               using their embed code or a download link. -->
          Your files are delivered via the link in your purchase email. If you have trouble accessing them,
          contact us at the email below.
        </p>
        <p class="text-dim text-xs">
          <!-- TODO: Replace with your actual support email -->
          Need help? Email <span class="text-accent">support@yourloadout.com</span>
        </p>
      </div>

      <!-- Back to browse -->
      <div data-reveal data-reveal-delay="3">
        <a href="/" class="text-accent hover:text-accent-soft text-sm font-medium transition-colors">
          ← Browse more bundles
        </a>
      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>
