---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/bundle/Hero.astro';
import Problem from '../../components/bundle/Problem.astro';
import TheShift from '../../components/bundle/TheShift.astro';
import WhatsInside from '../../components/bundle/WhatsInside.astro';
import SetupGuide from '../../components/bundle/SetupGuide.astro';
import SocialProof from '../../components/bundle/SocialProof.astro';
import Pricing from '../../components/bundle/Pricing.astro';
import Guarantee from '../../components/bundle/Guarantee.astro';
import FounderNote from '../../components/bundle/FounderNote.astro';
import FAQ from '../../components/bundle/FAQ.astro';
import FinalCTA from '../../components/bundle/FinalCTA.astro';

export async function getStaticPaths() {
  const bundles = await getCollection('bundles');
  return bundles
    .filter((b) => b.data.status === 'live') // only generate pages for live bundles
    .map((bundle) => ({
      params: { slug: bundle.id },
      props: { bundle },
    }));
}

const { bundle } = Astro.props;
const d = bundle.data;

const bundleURL = new URL(Astro.url.pathname, Astro.site);

// Product structured data — shows price/availability in search results.
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  description: d.tagline,
  category: 'SoftwareApplication',
  brand: { '@type': 'Brand', name: 'Loadout' },
  image: new URL('/og-default.png', Astro.site).href,
  offers: {
    '@type': 'Offer',
    price: d.price,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: bundleURL.href,
  },
};

// FAQ structured data — eligible for FAQ rich results.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title={d.name}
  description={`${d.tagline} — ${d.skillCount} skills, ${d.pluginCount} plugins, setup in under 30 minutes.`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(productLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <Nav checkoutUrl={d.checkoutUrl} />
  <main>
    <Hero bundle={d} />
    <Problem bundle={d} />
    <TheShift bundle={d} />
    <WhatsInside bundle={d} />
    <SetupGuide />
    <SocialProof />
    <Pricing bundle={d} />
    <Guarantee />
    <FounderNote bundle={d} />
    <FAQ bundle={d} />
    <FinalCTA bundle={d} />
  </main>
  <Footer />
</BaseLayout>
