---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Curated Claude AI skill bundles for your niche — beginner-friendly, live in under 30 minutes.',
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage ?? '/og-default.png', Astro.site);

const siteName = 'Loadout';
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.png', Astro.site).href,
  description:
    'Done-for-you Claude AI skill kits for sales, customer engagement, and operations teams.',
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL('/', Astro.site).href,
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons + theme -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="robots" content="index, follow" />

    <title>{title} | Loadout</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Loadout`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Loadout`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />

    <style is:global>
      html {
        background-color: #0A0A0B;
        color: #FAFAFA;
        scroll-behavior: smooth;
      }

      /* Scroll-reveal */
      [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      }
      [data-reveal].is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      [data-reveal-delay="1"] { transition-delay: 0.08s; }
      [data-reveal-delay="2"] { transition-delay: 0.16s; }
      [data-reveal-delay="3"] { transition-delay: 0.24s; }
      [data-reveal-delay="4"] { transition-delay: 0.32s; }
      [data-reveal-delay="5"] { transition-delay: 0.40s; }

      /* Prevent flash of unstyled content on fast connections */
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </head>
  <body class="font-sans antialiased min-h-screen bg-surface text-white">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
