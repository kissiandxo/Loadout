---
import { getCollection } from 'astro:content';
import BundleCard from '../BundleCard.astro';

const allBundles = await getCollection('bundles');
// Live bundles first, then coming-soon
const bundles = allBundles.sort((a, b) => {
  if (a.data.status === 'live' && b.data.status !== 'live') return -1;
  if (a.data.status !== 'live' && b.data.status === 'live') return 1;
  return 0;
});
---
<section id="bundles" class="py-28 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-6xl mx-auto">

    <div data-reveal class="mb-14">
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-3">Browse Bundles</h2>
      <p class="text-muted text-lg max-w-xl">
        Each bundle is built for one niche. Pick yours, install it, and hit the ground running.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {bundles.map((bundle, i) => (
        <BundleCard bundle={bundle} index={i} />
      ))}
    </div>

  </div>
</section>
