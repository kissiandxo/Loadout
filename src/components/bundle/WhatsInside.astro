---
interface Props {
  bundle: any;
}
const { bundle: d } = Astro.props;
---
<section class="py-24 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div data-reveal class="mb-14">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">What's inside</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-3">
        Everything you need. Nothing you don't.
      </h2>
      <div class="flex items-center gap-4 mt-4">
        <span class="text-xs font-semibold text-accent bg-accent-ghost border border-accent/20 px-3 py-1.5 rounded-full">
          {d.skillCount} Skills
        </span>
        <span class="text-xs font-semibold text-accent bg-accent-ghost border border-accent/20 px-3 py-1.5 rounded-full">
          {d.pluginCount} Plugins
        </span>
      </div>
    </div>

    <!-- Outcome Groups -->
    <div class="space-y-0">
      {d.whatsInside.map((group: any, i: number) => (
        <div
          data-reveal
          data-reveal-delay={String(Math.min(i + 1, 5))}
          class="border-t border-edge py-8 grid sm:grid-cols-[2fr_3fr] gap-6 sm:gap-12"
        >
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-6 h-6 rounded-md bg-accent-ghost border border-accent/25 flex items-center justify-center shrink-0">
                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-white font-bold text-base leading-tight">{group.outcome}</h3>
            </div>
          </div>
          <div>
            <p class="text-muted text-sm leading-relaxed mb-4">{group.description}</p>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item: string) => (
                <li class="text-xs text-dim bg-surface-3 border border-edge px-2.5 py-1 rounded">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
      <div class="border-t border-edge"></div>
    </div>

    <!-- Bonuses -->
    {d.bonuses.length > 0 && (
      <div data-reveal class="mt-14 p-6 rounded-lg border border-edge bg-surface-2">
        <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-5">Also included</p>
        <ul class="space-y-3">
          {d.bonuses.map((bonus: string) => (
            <li class="flex items-start gap-3">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-muted text-sm leading-relaxed">{bonus}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>
</section>
