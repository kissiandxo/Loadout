---
interface Props {
  bundle: any;
}
const { bundle: d } = Astro.props;
---
<section class="py-24 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto">

    <div data-reveal class="mb-12">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">Sound familiar?</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight">
        The part nobody talks about.
      </h2>
    </div>

    <ul class="space-y-6">
      {d.problem.map((pain: string, i: number) => (
        <li
          data-reveal
          data-reveal-delay={String(Math.min(i + 1, 4))}
          class="flex gap-5 items-start"
        >
          <div class="w-1 h-1 rounded-full bg-accent mt-2.5 shrink-0 ring-4 ring-accent/20"></div>
          <p class="text-muted text-lg leading-relaxed">{pain}</p>
        </li>
      ))}
    </ul>

  </div>
</section>
