---
interface Props {
  bundle: any;
}
const { bundle: d } = Astro.props;
---
<section class="py-24 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto">
    <div data-reveal>
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-6">The shift</p>
      <blockquote class="text-2xl sm:text-3xl font-bold text-white leading-snug border-l-2 border-accent pl-8">
        {d.shift}
      </blockquote>
    </div>
  </div>
</section>
