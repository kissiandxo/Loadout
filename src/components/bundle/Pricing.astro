---
interface Props {
  bundle: any;
}
const { bundle: d } = Astro.props;
const standardPlusPrice = d.price + d.bumpPrice;
---
<section id="pricing" class="py-24 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto">

    <!-- Value anchor -->
    <div data-reveal class="mb-14">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">Pricing</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-6">
        One payment. No subscription.<br />No surprises.
      </h2>
      <p class="text-muted text-lg max-w-2xl leading-relaxed">
        A BDC coordinator costs $3,000+ a month. A copywriter charges $100/hour. A sales coach
        charges $2,000 for a workshop. The Sales Loadout is <span class="text-white font-semibold">${d.price}</span>, one time.
      </p>
    </div>

    <!-- Tiers -->
    <div class="grid sm:grid-cols-3 gap-5">

      <!-- Standard -->
      <div data-reveal data-reveal-delay="1" class="flex flex-col p-6 rounded-lg border border-edge bg-surface-2">
        <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">Standard</p>
        <div class="mb-6">
          <span class="text-4xl font-black text-white">${d.price}</span>
          <span class="text-muted text-sm ml-2">one-time</span>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            {d.skillCount} skills + {d.pluginCount} plugins
          </li>
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Step-by-step setup guide
          </li>
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            30-day prompt cheat sheet
          </li>
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            5 done-for-you script templates
          </li>
        </ul>
        <a
          href={d.checkoutUrl}
          class="w-full text-center text-sm font-semibold border border-edge hover:border-accent/60 text-white px-5 py-3 rounded-lg transition-all duration-200 hover:bg-surface-3"
        >
          Get Instant Access
        </a>
      </div>

      <!-- Standard + Vault (highlighted) -->
      <div data-reveal data-reveal-delay="2" class="flex flex-col p-6 pt-9 rounded-lg border-2 border-accent bg-surface-2 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
          <span class="text-xs font-bold text-white bg-accent px-3 py-1 rounded-full whitespace-nowrap">Most Popular</span>
        </div>
        <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">Standard + {d.bumpName}</p>
        <div class="mb-6">
          <span class="text-4xl font-black text-white">${standardPlusPrice}</span>
          <span class="text-muted text-sm ml-2">one-time</span>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Everything in Standard
          </li>
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span><span class="text-white font-medium">{d.bumpName}:</span> {d.bumpDescription}</span>
          </li>
        </ul>
        <a
          href={d.bumpUrl}
          class="w-full text-center text-sm font-semibold bg-accent hover:bg-accent-hover text-white px-5 py-3 rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-accent/20"
        >
          Get Standard + Vault
        </a>
      </div>

      <!-- Done-With-You -->
      <div data-reveal data-reveal-delay="3" class="flex flex-col p-6 rounded-lg border border-edge bg-surface-2">
        <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">{d.premiumName}</p>
        <div class="mb-6">
          <span class="text-4xl font-black text-white">${d.premiumPrice}</span>
          <span class="text-muted text-sm ml-2">one-time</span>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Everything in Standard
          </li>
          <li class="flex gap-2.5 items-start text-sm text-muted">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#3B82F6" stroke-width="2.5" class="mt-0.5 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{d.premiumDescription}</span>
          </li>
        </ul>
        <a
          href={d.premiumUrl}
          class="w-full text-center text-sm font-semibold border border-edge hover:border-accent/60 text-white px-5 py-3 rounded-lg transition-all duration-200 hover:bg-surface-3"
        >
          Book Your Setup Call
        </a>
      </div>

    </div>

  </div>
</section>
