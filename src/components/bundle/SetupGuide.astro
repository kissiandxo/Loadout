---
const steps = [
  { n: '1', title: 'Get Claude', body: 'Claude Code (the free CLI) for the one-command install, or Claude Pro ($20/month) for the web. Either works.' },
  { n: '2', title: 'Open the kit in Claude Code', body: 'Unzip the kit and open the folder in Claude Code. Prefer the web? A copy-paste Setup Guide is included.' },
  { n: '3', title: 'Type /loadout-setup', body: 'Claude installs every skill, command and plugin, checks they work, and tells you how to start. A couple of minutes, hands-off.' },
  { n: '4', title: 'Run your first skill', body: "Pick something from your day — a follow-up email, a prep task, a summary. Try it. You'll see immediately why this matters." },
];
---
<section class="py-24 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto">

    <div data-reveal class="mb-14">
      <p class="text-xs font-semibold text-muted uppercase tracking-widest mb-4">Setup</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-3">
        Type one command.<br />Claude installs it for you.
      </h2>
      <p class="text-muted text-lg">
        Open the kit in Claude Code and type <code class="text-accent">/loadout-setup</code> — it sets everything up and verifies it. No tech skills required. (Prefer the web? A copy-paste guide is included.)
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {steps.map((step, i) => (
        <div
          data-reveal
          data-reveal-delay={String(i + 1)}
          class="p-6 rounded-lg border border-edge bg-surface-2"
        >
          <div class="w-8 h-8 rounded-md bg-accent-ghost border border-accent/25 flex items-center justify-center mb-4">
            <span class="text-accent font-bold text-sm">{step.n}</span>
          </div>
          <h3 class="text-white font-bold text-base mb-2">{step.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{step.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
