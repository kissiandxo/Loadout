---
interface Props {
  bundle: any;
}
const { bundle: d } = Astro.props;
---
<section class="py-28 px-5 sm:px-8 border-t border-edge">
  <div class="max-w-4xl mx-auto text-center">

    <div data-reveal>
      <h2 class="text-4xl sm:text-5xl font-black text-white leading-tight mb-4">
        Your pipeline won't manage itself.
      </h2>
      <p class="text-muted text-xl mb-10 max-w-xl mx-auto leading-relaxed">
        {d.name}. ${d.price}, one time. Running in under 30 minutes.
      </p>
    </div>

    <div data-reveal data-reveal-delay="1" class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={d.checkoutUrl}
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-semibold px-10 py-4 rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-accent/25 text-sm w-full sm:w-auto justify-center"
      >
        Get {d.name} — ${d.price}
      </a>
      <p class="text-dim text-sm">14-day guarantee. No recurring fees.</p>
    </div>

  </div>
</section>
