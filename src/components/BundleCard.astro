---
import type { CollectionEntry } from 'astro:content';

interface Props {
  bundle: CollectionEntry<'bundles'>;
  index?: number;
}

const { bundle, index = 0 } = Astro.props;
const d = bundle.data;
const isLive = d.status === 'live';
const href = isLive ? `/bundles/${bundle.id}` : undefined;
const delay = String(Math.min(index + 1, 5));
---
<div
  data-reveal
  data-reveal-delay={delay}
  class:list={[
    'relative flex flex-col rounded-lg border transition-all duration-300',
    isLive
      ? 'border-edge bg-surface-2 hover:border-accent/50 hover:bg-surface-3 group cursor-pointer'
      : 'border-edge/40 bg-surface-2/50 opacity-60',
  ]}
>
  {isLive ? (
    <a href={href} class="absolute inset-0 z-10 rounded-lg" aria-label={`View ${d.name}`} />
  ) : null}

  <div class="p-6 flex flex-col flex-1">
    <!-- Header -->
    <div class="flex items-start justify-between mb-5">
      <span class="text-xs font-medium text-muted uppercase tracking-widest leading-none">
        {d.niche}
      </span>
      {!isLive && (
        <span class="text-xs font-semibold text-accent bg-accent-ghost border border-accent/20 px-2.5 py-1 rounded-full">
          Coming Soon
        </span>
      )}
    </div>

    <!-- Name + Tagline -->
    <h3 class:list={['text-xl font-bold text-white mb-2 leading-tight', isLive && 'group-hover:text-accent-soft transition-colors duration-200']}>
      {d.name}
    </h3>
    <p class="text-muted text-sm leading-relaxed flex-1 mb-6">
      {d.tagline}
    </p>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-4 border-t border-edge/60">
      <div class="flex items-center gap-3 text-xs text-dim">
        <span>{d.skillCount} skills</span>
        <span class="text-edge">·</span>
        <span>{d.pluginCount} plugins</span>
      </div>
      {isLive ? (
        <div class="flex items-center gap-1.5">
          <span class="text-white font-bold text-base">${d.price}</span>
          <span class="text-dim text-xs">one-time</span>
        </div>
      ) : null}
    </div>
  </div>
</div>
